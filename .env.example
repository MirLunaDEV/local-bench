# Copy to .env in the directory where you start local-bench.
# These fill only names that are not already set in the shell.
# Empty values are skipped. .env is gitignored.
# Local servers accept any API key. Leave this empty to use "local".
OPENAI_API_KEY=

# Extra OpenAI-compatible server to probe, for example http://127.0.0.1:11434/v1
LOCAL_BENCH_BASE_URL=

# Question cache. Default is ~/.cache/local-bench
LOCAL_BENCH_CACHE=
